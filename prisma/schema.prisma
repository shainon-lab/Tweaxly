// Prisma schema for the AI CFO MVP.
// SQLite for fast local dev — swap provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  passwordHash              String
  name                      String?
  // System-level role. Most users are "user". A small set of internal
  // operators are flagged "super_admin" and can see the /admin panel +
  // impersonate any business account. This is the ONLY tenant-spanning
  // permission; per-account permissions live on BusinessMembership.role.
  systemRole                String               @default("user")
  // Stamped on every successful /api/auth/login. Drives 'last login'
  // columns in the admin Customer 360.
  lastLoginAt               DateTime?
  // ── Email verification ────────────────────────────────────────────
  // Stamped once when the user clicks the verification link in the
  // welcome email. Null = not verified yet. Drives the persistent
  // "verify your email" banner inside the app + (future) gating of
  // premium features once the grace period expires.
  emailVerified                DateTime?
  // Hashed verification token (SHA-256). The plaintext token lives
  // ONLY in the email body + the verify-email URL. We store the hash
  // so a database leak doesn't compromise verification flows. Cleared
  // after a successful verification.
  emailVerificationTokenHash   String?
  // 24-hour token expiry. After this, the token is rejected and the
  // user has to hit Resend to get a fresh one.
  emailVerificationExpiresAt   DateTime?
  // Stamped every time we send a verification email. Used for the
  // 60-second resend cooldown enforced server-side.
  emailVerificationSentAt      DateTime?
  // ── Google OAuth ──────────────────────────────────────────────────
  // Google's stable "sub" claim - never email, never display name.
  // Unique so we can look up an existing Google-linked user by it,
  // and so account-linking can detect collisions. Null for users
  // who only signed in via email/password.
  googleId                     String? @unique
  // Snapshot of the user's Google profile picture URL captured at
  // first sign-in. Optional - the UI uses it where useful (workspace
  // switcher initials, etc.) and falls back to initials when null.
  avatarUrl                    String?
  // BCP-47 / two-letter language code for the UI. 'en' = English,
  // 'he' = Hebrew (RTL). Falls back to 'en' for any locale missing
  // from the dictionary.
  preferredLanguage         String               @default("en")
  // ISO 3166-1 alpha-2 country code for the user's region. Auto-
  // detected from the IP on first signup / first visit to the
  // preferences page when null; the user can override it from
  // Account → Language & Region. Nullable so we never block on
  // detection failing.
  region                    String?
  // ── Communication preferences ─────────────────────────────────────
  // Transactional / system emails (billing, security, password reset)
  // are governed by `systemEmails` and CANNOT be turned off while the
  // account is active — they're contractually required. Marketing
  // channels each have their own flag and default to OFF (explicit
  // opt-in only).
  systemEmails              Boolean              @default(true)
  marketingEmails           Boolean              @default(false)
  marketingSMS              Boolean              @default(false)
  productAnnouncements      Boolean              @default(false)
  newsletter                Boolean              @default(false)
  // Audit fields for the marketing consent record itself. Stamped at
  // the moment the user grants or revokes any marketing channel — the
  // most recent change overwrites previous values; full history lives
  // in AuditLog.
  marketingConsentTimestamp DateTime?
  marketingConsentSource    String? // "signup" | "settings" | "import"
  marketingConsentIp        String? // captured for the consent record
  marketingPolicyVersion    String? // /privacy version at consent time
  // Per-user opaque token used to verify one-click unsubscribe links
  // without requiring a session. Lazily populated on first marketing
  // grant so accounts that never opt in don't generate one.
  unsubscribeToken          String?              @unique
  createdAt                 DateTime             @default(now())
  businesses                Business[]
  memberships               BusinessMembership[]
  membershipInvitesSent     BusinessMembership[] @relation("MembershipInviter")
  invitationsSent           BusinessInvitation[] @relation("InvitationInviter")
  auditLogs                 AuditLog[]           @relation("ActorAuditLogs")
  passwordResetTokens       PasswordResetToken[]
  loginAttempts             LoginAttempt[]
  authoredAdminNotes        AdminNote[]          @relation("AdminNoteAuthor")
  // Billing back-relations (see Billing models at the bottom of this file).
  assignedPlanOverrides     AdminPlanOverride[]  @relation("AdminPlanOverrideAssignedBy")
  revokedPlanOverrides      AdminPlanOverride[]  @relation("AdminPlanOverrideRevokedBy")
  createdCoupons            Coupon[]             @relation("CouponCreatedBy")
  targetedCoupons           Coupon[]             @relation("CouponTargetUser")
  couponRedemptions         CouponRedemption[]
  polarOrders               PolarOrder[]
  // Real-Time Business Alerts (Premium)
  alertPreferences          AlertPreference[]
  pushSubscriptions         PushSubscription[]
  alertNotifications        AlertNotification[]
  createdSharedAnalyses     SharedAnalysis[]     @relation("SharedAnalysisCreator")
}

// Suppression list for sent campaigns. Even if a user has the matching
// flag flipped back on, the campaign sender SHOULD consult this table
// and skip recipients whose email + channel pair is present (the
// classic anti-spam pattern: bounces, complaints, and explicit opt-outs
// stick across re-subscriptions).
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String
  // "marketing_email" | "marketing_sms" | "newsletter" | "product_announcements"
  channel   String
  // "user_unsubscribe" | "bounce" | "complaint" | "admin"
  reason    String
  source    String? // free-form context — campaign id, IP, etc.
  createdAt DateTime @default(now())

  @@unique([email, channel])
  @@index([email])
}

// Recorded for every /api/auth/login attempt. Success rows drive
// 'last login' + login-history surfaces; failure rows surface 'failed
// attempts' in the security tab and feed brute-force monitoring.
model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Always recorded — even when the user can't be resolved (unknown
  // email) — so we can surface enumeration attempts.
  email     String
  success   Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

// Internal note attached to an account. Visible only inside the
// admin panel; never exposed to the customer.
model AdminNote {
  id               String   @id @default(cuid())
  targetBusinessId String
  targetBusiness   Business @relation(fields: [targetBusinessId], references: [id], onDelete: Cascade)
  authorUserId     String
  author           User     @relation("AdminNoteAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  body             String
  // Free-form comma-joined tags: "onboarding,billing,bug,sales,
  // churn_risk,vip". Kept as a single string so we don't need a
  // tag table; the admin UI parses on commas.
  tags             String?
  createdAt        DateTime @default(now())

  @@index([targetBusinessId, createdAt])
}

// Single-use, hashed, time-boxed password reset token. We never store
// the plaintext token — only the SHA-256 hash — so a DB leak can't be
// turned into account takeovers. Token is invalidated on first use
// (usedAt set) and ignored after expiresAt.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Many-to-many between User and Business with a per-account role.
// Today every Business has exactly one membership (the owner, as
// account_admin), but the model supports inviting collaborators later
// without another migration.
model BusinessMembership {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Per-workspace role:
  //   "owner"  - workspace creator. Full access incl. billing,
  //              members, delete workspace. Always exactly one per
  //              workspace.
  //   "admin"  - can use the app + manage data; cannot access billing
  //              or invite/remove members.
  //   "viewer" - read-only.
  // Legacy values ("account_admin", "user", "accountant") may still
  // exist on rows created before the invitations system; treat
  // anything other than "owner"/"admin"/"viewer" as legacy and map
  // to a sensible default in code.
  role       String    @default("admin")
  // Membership lifecycle:
  //   "active"    - normal access.
  //   "suspended" - non-owner membership paused (e.g. workspace
  //                 downgraded to Free). Reactivates automatically
  //                 when the workspace is back on Pro.
  //   "removed"   - soft-removed; not displayed in switcher.
  status     String    @default("active")
  invitedBy  String?
  inviter    User?     @relation("MembershipInviter", fields: [invitedBy], references: [id], onDelete: SetNull)
  invitedAt  DateTime?
  joinedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
}

// Outstanding invitation to join a workspace. One row per outstanding
// invite; once accepted, we create a BusinessMembership and mark the
// invitation row "accepted". Pending invitations count toward the
// workspace's member-limit so a Pro workspace can't invite 50 people
// "for later" to dodge the cap.
model BusinessInvitation {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Email the invitation was issued to. Normalised lowercase on write
  // so the acceptance check is symmetric with User.email storage.
  email           String
  // Role the user will get when they accept ("admin" | "viewer").
  // The "owner" role is never offered through invitations.
  role            String   @default("admin")
  invitedByUserId String
  invitedBy       User     @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the single-use token. Plaintext token lives only
  // in the invitation email + the accept URL - matches the email-
  // verification pattern so a DB leak can't be turned into a free
  // workspace membership.
  tokenHash       String   @unique
  // "pending" | "accepted" | "cancelled" | "expired". Status is
  // updated on the row instead of deleting so we keep an audit trail.
  status          String   @default("pending")
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedByUserId String?
  createdAt       DateTime @default(now())

  @@index([businessId, status])
  @@index([email, status])
}

// Tenant-spanning audit trail. Records every super_admin action that
// touches a customer account (impersonation enter/exit, status change,
// etc.). Never store secrets here.
model AuditLog {
  id               String    @id @default(cuid())
  actorUserId      String
  actor            User      @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: Cascade)
  // Target business (nullable for actions that aren't account-scoped).
  targetBusinessId String?
  targetBusiness   Business? @relation("AuditLogs", fields: [targetBusinessId], references: [id], onDelete: SetNull)
  // Free-form action key, e.g. "impersonation.enter", "impersonation.exit",
  // "account.status_change", "account.allow_writes".
  action           String
  // Structured detail (JSON-encoded string). Anything sensitive should be
  // hashed / redacted before being stored here.
  metadata         String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetBusinessId, createdAt])
}

model Business {
  id               String    @id @default(cuid())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  currency         String    @default("USD")
  fiscalStartMonth Int       @default(1)
  vatEnabled       Boolean   @default(false)
  vatRate          Float?    @default(0)
  // Optional business branding. Both stored as data URLs (base64-encoded) so
  // they can be rendered directly into <img src> / <link rel="icon"> without
  // a separate file-serving layer.
  logoData         String?
  faviconData      String?
  // Account-level lifecycle: "active" | "suspended" | "demo" | "test".
  // Suspended accounts are blocked from API access (login still works
  // so the user can see the suspension message). Demo/test accounts
  // are surfaced separately in the admin panel.
  status           String    @default("active")
  // Stamped on every authenticated request that hits this business
  // (via the requireBusiness middleware). Used for 'last activity'
  // sorting in the admin panel.
  lastActivityAt   DateTime?
  // Commercial metadata. None are billing-grade — they describe what
  // plan/trial the operator has manually assigned. Wire to Stripe
  // when payments land.
  plan             String    @default("free") // free | starter | pro | enterprise | custom
  trialEndsAt      DateTime?
  // Self-reported / operator-set profile.
  industry         String?
  country          String?
  timezone         String?
  // Adaptive-onboarding answers. Drive how signals, forecast
  // messaging, and dashboard recommendations adapt to the
  // business's maturity + priorities.
  //
  //   businessStage    — "new" | "growing" | "established"
  //   businessFormat   — "sole_prop" | "llc" | "partnership" | "other"
  //   hasAnnualReports — true / false / null (not yet answered)
  //   paysSalaries     — true / false / null
  //   goals            — comma-separated keys from a fixed list
  //                      (profitability, expenses, cashflow, trends,
  //                       growth, certainty)
  //   onboardedAt      — null until the wizard completes (or is
  //                      explicitly skipped via Demo mode). Used to
  //                      gate whether the wizard fires on next login.
  businessStage    String?
  businessFormat   String?
  hasAnnualReports Boolean?
  paysSalaries     Boolean?
  goals            String?
  onboardedAt      DateTime?
  createdAt        DateTime  @default(now())

  memberships         BusinessMembership[]
  invitations         BusinessInvitation[]
  auditLogs           AuditLog[]            @relation("AuditLogs")
  adminNotes          AdminNote[]
  categories          Category[]
  uploads             UploadBatch[]
  transactions        Transaction[]
  rules               CategorizationRule[]
  vendorizationRules  VendorizationRule[]
  duplicateGroups     DuplicateGroup[]
  employees           Employee[]
  employeeEvents      EmployeeEvent[]
  forecastItems       ForecastItem[]
  forecastAssumptions ForecastAssumption[]
  mutedSignals        MutedSignal[]
  mappingTemplates    MappingTemplate[]
  financialSources    FinancialSource[]
  plaidConnections    PlaidConnection[]
  businessSignals     BusinessSignal[]
  trashBatches        TrashBatch[]
  recommendations     Recommendation[]
  consultations       Consultation[]
  manualEntries       ManualEntry[]
  notificationRules   NotificationRule[]
  vendors             Vendor[]
  // Billing back-relations.
  subscriptions       Subscription[]
  planOverrides       AdminPlanOverride[]
  creditWallet        AiCreditWallet?
  creditTransactions  AiCreditTransaction[]
  targetedCoupons     Coupon[]              @relation("CouponTargetBusiness")
  couponRedemptions   CouponRedemption[]
  polarOrders         PolarOrder[]
  profile             BusinessProfile?
  alertPreferences    AlertPreference[]
  alertNotifications  AlertNotification[]
  sharedAnalyses      SharedAnalysis[]
}

// Real-Time Business Alerts (Premium) - per-user × per-business
// preferences for desktop push, in-app, email; category toggles,
// sensitivity, quiet hours, daily limit. One row per (userId,
// businessId) pair so the same user can configure each workspace
// independently.
model AlertPreference {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Delivery channels
  pushEnabled        Boolean  @default(false)
  inAppEnabled       Boolean  @default(true)
  emailEnabled       Boolean  @default(false)

  // Category toggles - which classes of alert the user wants to hear.
  // Stored as a Json bag so we can add new categories without a
  // migration; keys mirror the AlertCategory enum in code.
  categories         Json?

  // "conservative" | "balanced" | "aggressive"
  sensitivity        String   @default("balanced")

  // Quiet hours - HH:MM-HH:MM local time + IANA timezone. When
  // quietHoursEnabled, non-critical alerts are delayed until the
  // window ends. criticalBypass lets critical alerts ring through
  // anyway.
  quietHoursEnabled  Boolean  @default(false)
  quietHoursStart    String?  // "22:00"
  quietHoursEnd      String?  // "07:00"
  quietHoursTimezone String?  // "America/New_York"
  criticalBypass     Boolean  @default(true)

  // Hard daily cap so the system can never flood a user. Default is
  // a safe upper bound; the dispatcher counts deliveries against it.
  dailyLimit         Int      @default(15)

  // Phase-4 sweep throttle. The dispatcher checks this on every page
  // load that hooks into sweepAndDispatch() and bails out if it ran
  // recently - bounds the per-user work even when the workspace is
  // active across many tabs.
  lastSweepAt        DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, businessId])
  @@index([businessId])
}

// One PushSubscription per (user, device/browser). The push endpoint
// + p256dh + auth keys are what `web-push` needs to dispatch a
// notification. Devices unsubscribe → row deleted.
model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint    String   @unique
  p256dh      String
  authKey     String
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([userId])
}

// Every alert that fires lands here - the Notification Center reads
// it, the dispatcher writes it, and the delivery columns record what
// the dispatcher tried + how each channel responded. One row per
// alert; per-channel delivery state stored together so the inbox
// reads in a single query.
model AlertNotification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // What kind of alert this is. "signal" = AI-detected; "monitor" =
  // user-defined rule fired. The sourceKey is the signalKey or
  // monitor id so the inbox can group / dedupe.
  source       String   // "signal" | "monitor"
  sourceKey    String

  // Routing + ranking metadata.
  category     String   // mirrors AlertCategory in code
  severity     String   // "critical" | "important" | "info"

  // Content (denormalised so the inbox never needs a join to read).
  title        String
  body         String
  // Optional href the CTA points at, e.g. "/forecast?focus=cashflow".
  deepLink     String?

  // Inbox state
  readAt       DateTime?

  // Per-channel delivery
  pushSentAt   DateTime?
  pushError    String?
  emailSentAt  DateTime?
  emailError   String?

  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([businessId])
}

// Business DNA - the workspace's strategic identity. Captured during
// onboarding (or filled in later from Settings) via a short 7-question
// flow. Used to permanently bias every Claude-powered surface
// (consultation, executive summary, signal interpretation, forecasts)
// so the AI reasons in the context of THIS business - its industry,
// model, customers, stage, goals, challenges, and which KPIs the
// owner actually cares about. One row per Business; absence means the
// dashboard shows a "Complete your Business Profile" banner.
model BusinessProfile {
  id                 String    @id @default(cuid())
  businessId         String    @unique
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // The 7 strategic onboarding questions. All nullable so partial
  // saves are valid (the UI saves per-step in the wizard).
  industry           String?   // free text + searchable dropdown
  // Specific business category - "Recording Studio", "Jewelry Store",
  // "Dental Clinic", etc. A second pass after industry that narrows
  // the AI's reasoning vocabulary. Typeahead from a curated list with
  // free-text fallback.
  businessCategory   String?
  businessModels     String[]  // multi-select - subscription, services, etc.
  mainGoal           String?   // growth | profitability | stability | ...
  customerType       String?   // b2b | b2c | enterprise | smb | ...
  revenueStage       String?   // early | growing | established | ...
  biggestChallenge   String?   // free text - used when "other" is in businessChallenges
  // Multi-select of preset SMB challenges (max 3 enforced in the UI
  // + API). Includes a sentinel "other" value which, when selected,
  // unlocks the biggestChallenge free-text field above.
  businessChallenges String[]  @default([])
  importantKpis      String[]  // multi-select - revenue_growth, mrr, ...

  // AI-generated "About Your Business" summary - 80-200 words. Built
  // from the 7 fields above + the live BusinessContext at generation
  // time. Editable manually; regeneratable on demand. The
  // aiSummaryUpdatedAt timestamp lets us show "regenerated 2 days
  // ago" + auto-refresh once enough new data lands.
  aiSummary          String?
  aiSummaryUpdatedAt DateTime?

  // Phase-3 AI Context Preferences. Free-text hints + a set of named
  // bias toggles ("prefer_conservative_forecasting", "focus_growth"
  // etc.) that further shape the advisor's tone + ranking. Persisted
  // as JSON so we can evolve the shape without a migration per new
  // preference.
  aiContextPreferences Json?

  // Phase-3 Smart Evolution. Auto-derived observations Tweaxly
  // notices about the business over time ("highly seasonal", "revenue
  // depends on paid acquisition", etc.). Refreshed periodically by
  // the enrichment job; the timestamp drives a 7-day staleness check
  // so we don't re-run the detection on every dashboard hit.
  derivedSignals     String[]  @default([])
  lastDerivedAt      DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model NotificationRule {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // What to watch: "revenue" | "expenses" | "net" | "category"
  metric         String
  // Required when metric = "category"; null otherwise.
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // "increase" | "decrease"
  direction      String
  // "percent" | "amount"
  thresholdType  String
  // For percent: store as 0-100 (e.g. 10 means "10%"). For amount: money value.
  thresholdValue Float
  // Comparison window: "month" | "quarter" | "year".
  period         String
  // Optional friendly label the user can set for this rule.
  label          String?
  enabled        Boolean   @default(true)
  // Phase-3 Monitor v2: severity of the alert when the rule fires
  // ("critical" | "important" | "info" - default "important"), plus
  // a per-monitor channel preference bag (push/inApp/email booleans)
  // that overrides the user's general toggles when set. The Phase-4
  // dispatcher reads these to decide how loud each fire should be.
  severity              String   @default("important")
  notificationChannels  Json?
  // Stamped the first time we see this rule actually firing. Persisted so
  // the Alerts UI can display a meaningful timestamp ("appeared 3 days
  // ago") even though triggers are evaluated live.
  firstFiredAt   DateTime?
  // Set when the user clicks "Mark as read" on this alert. The notification
  // continues to appear (now in the Previous section), but the unread
  // badge no longer counts it.
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([businessId])
}

model Category {
  id                String             @id @default(cuid())
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  // kind: revenue, fixed, variable, payroll, marketing, fee, tax, transfer, other
  kind              String
  isOneTime         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  transactions      Transaction[]
  manualEntries     ManualEntry[]
  notificationRules NotificationRule[]
  vendors           Vendor[]           @relation("VendorCategory")

  // Optional "primary" vendor for the category. Surfaced in the Settings
  // categories table as the headline vendor (defaults to GENERAL when null).
  primaryVendorId String?
  primaryVendor   Vendor? @relation("CategoryPrimaryVendor", fields: [primaryVendorId], references: [id], onDelete: SetNull)

  @@unique([businessId, name])
}

model Vendor {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  categoryId String?
  category   Category? @relation("VendorCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  // Like Category.isOneTime — transactions matching this vendor inherit
  // this default when no transaction-level override is set.
  isOneTime  Boolean   @default(false)
  // Alternate names this vendor absorbed via merges (lowercase).
  // Upload-time vendor lookup matches by name OR by any alias, so a
  // future upload of "Interest X" finds the canonical "Bank Leumi"
  // vendor that absorbed it in a prior merge.
  aliases    String[]  @default([])
  createdAt  DateTime  @default(now())

  // Reverse side of Category.primaryVendor relation.
  primaryForCategories Category[] @relation("CategoryPrimaryVendor")

  @@unique([businessId, name])
  @@index([businessId, categoryId])
}

model MappingTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  source     String // bank | credit_card | paypal | stripe | invoicing | payroll | other
  // JSON string: { date, amount, description, currency, txnId, source, category, notes }
  mapping    String
  createdAt  DateTime @default(now())

  @@unique([businessId, name])
}

model UploadBatch {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source          String // bank | credit_card | paypal | stripe | invoicing | payroll | other | monthly_summary
  // mode: transactions (per-row activity) | monthly_summary (single-month totals per category)
  mode            String        @default("transactions")
  filename        String
  rowCount        Int           @default(0)
  // For monthly_summary uploads: the YYYY-MM the data represents (derived from the calendar date)
  representsMonth String?
  createdAt       DateTime      @default(now())
  transactions    Transaction[]

  // ─── Financial Sources (Phase 1 of the Financial Data Pipeline) ─────
  // Optional today so existing/legacy upload paths keep working; the
  // new guided bank-statement wizard always sets these. financialSourceId
  // identifies which Bank / Card / PayPal account the file came from;
  // periodStart..periodEnd is the YYYY-MM coverage window (inclusive)
  // used by the monthly coverage matrix + overlap detection.
  financialSourceId String?
  financialSource   FinancialSource? @relation(fields: [financialSourceId], references: [id], onDelete: SetNull)
  periodStart       String? // YYYY-MM, inclusive
  periodEnd         String? // YYYY-MM, inclusive
  // "active" or "replaced". Replaced batches keep their transactions
  // deleted but stay in the table as an audit trail; replacedById points
  // at the batch that supersedes them.
  status            String   @default("active")
  replacedAt        DateTime?
  replacedById      String?
  replacedBy        UploadBatch?  @relation("ReplaceChain", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          UploadBatch[] @relation("ReplaceChain")

  @@index([businessId, financialSourceId])
  @@index([businessId, periodStart, periodEnd])
  @@index([businessId, status])
}

// ─── Financial Source ─────────────────────────────────────────────────
// Workspace-scoped account that uploads belong to. Examples:
//   "Business Bank ILS", "Visa Card", "PayPal USD". All transactions
// imported through the guided wizard are tagged with one of these so
// the coverage matrix can show which months are uploaded per account
// and the duplicate-prevention layer can scope overlap checks correctly.
model FinancialSource {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Human-friendly label shown in the picker and coverage matrix.
  name         String
  // bank | credit_card | paypal | payment_provider | cash | other | plaid
  type         String
  currency     String // ISO 4217
  last4        String? // optional last 4 digits, e.g. for cards
  // YYYY-MM — first month this source is relevant. Used to scope the
  // coverage matrix (we don't ask for months before this).
  startMonth   String
  // "active" or "archived". Archived sources hide from pickers but
  // retain their batch history.
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Plaid linkage. Populated only for sources that were auto-created
  // by a Plaid connection - one FinancialSource per linked account.
  // plaidAccountId is Plaid's stable per-account identifier; we use
  // it to upsert balances + scope transaction inserts to the right
  // source on every sync.
  plaidConnectionId String?
  plaidConnection   PlaidConnection? @relation(fields: [plaidConnectionId], references: [id], onDelete: SetNull)
  plaidAccountId    String? // Plaid's account_id
  currentBalance    Float?  // most recent balance snapshot
  availableBalance  Float?

  uploadBatches UploadBatch[]

  @@unique([businessId, name])
  @@unique([plaidConnectionId, plaidAccountId])
  @@index([businessId, status])
  @@index([plaidConnectionId])
}

// One row per linked Plaid Item (= one bank login that may expose
// multiple accounts). The encrypted access_token + sync cursor live
// here; FinancialSource rows for each account fan out from this.
// Tweaxly is read-only — we never call /transactions/sync's payment
// or auth surfaces and we never store the public_token.
model PlaidConnection {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Plaid Item identifier — stable across re-auth, returned by
  // /item/get. Unique so a re-link surfaces as an update, not a dup.
  itemId            String   @unique
  // AES-256-GCM ciphertext of the access_token. Never logged, never
  // returned to the frontend, never serialized into any response.
  accessTokenEnc    String
  // Institution metadata for the UI.
  institutionId     String?
  institutionName   String?
  // Cursor for Plaid /transactions/sync. Empty string = full history
  // hasn't been fetched yet; populated after first sync completes.
  syncCursor        String   @default("")
  // "connected" | "syncing" | "error" | "disconnected"
  status            String   @default("syncing")
  // Last error message surfaced from Plaid - cleared on next success.
  lastError         String?
  lastSyncStartedAt   DateTime?
  lastSyncCompletedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  financialSources  FinancialSource[]

  @@index([businessId])
  @@index([businessId, status])
}

model Transaction {
  id                   String          @id @default(cuid())
  businessId           String
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  uploadBatchId        String?
  uploadBatch          UploadBatch?    @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  source               String
  originalSourceFile   String?
  externalId           String?
  transactionDate      DateTime
  accountingMonth      String // YYYY-MM
  // `amount` is the canonical value in the business base currency.
  // Reports, dashboards, forecasts, AI insights all read this. For
  // transactions that originated in a different currency, the
  // pre-conversion value is preserved in `originalAmount` /
  // `originalCurrency` and is never recalculated automatically.
  amount               Float // signed; in business base currency
  // `currency` is the *original* currency of the transaction at the
  // time it was imported. For backward compat with pre-multi-currency
  // rows, this may equal the base currency if no conversion was done.
  currency             String          @default("USD")
  // ── Multi-currency snapshot fields ────────────────────────────────
  // Captured once at import/creation time and treated as a permanent
  // historical record. Do not back-fill rates onto existing
  // transactions when the rate provider changes — the original
  // conversion remains authoritative for accounting purposes.
  originalAmount       Float? // pre-conversion amount (signed)
  originalCurrency     String? // ISO 4217 of the source data
  baseCurrency         String? // business base currency at import
  exchangeRate         Float? // multiplier from original → base
  exchangeRateDate     DateTime? // date the rate applies to
  exchangeRateSource   String? // "frankfurter" | "ecb" | "manual" | "same_currency"
  conversionMethod     String? // "daily_historical" | "monthly_avg" | "manual_fixed" | "none"
  isConverted          Boolean         @default(false)
  manualRateOverride   Boolean         @default(false)
  manualRateNote       String?
  // "success" | "missing" | "failed" | "manual" | "same_currency" | "needs_review"
  rateFetchStatus      String?
  type                 String // income | expense | transfer | fee | payroll | tax | other
  categoryId           String?
  category             Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory          String?
  vendor               String?
  description          String          @default("")
  isRecurring          Boolean         @default(false)
  isOneTime            Boolean         @default(false)
  isDuplicateCandidate Boolean         @default(false)
  // When set, the user explicitly dismissed this transaction's
  // duplicate alert. Future uploads must skip it in the duplicate
  // scan so we never re-flag a row the owner already triaged.
  duplicateDismissedAt DateTime?
  isExcludedFromPnl    Boolean         @default(false)
  // Free-form note explaining WHY this transaction is excluded (e.g. "personal
  // purchase on shared bank account"). Shown as a hover tooltip on the
  // "not calculated" pill in the Transactions table.
  excludeNote          String?
  notes                String?
  duplicateGroupId     String?
  duplicateGroup       DuplicateGroup? @relation(fields: [duplicateGroupId], references: [id], onDelete: SetNull)
  manualEntryId        String?
  manualEntry          ManualEntry?    @relation(fields: [manualEntryId], references: [id], onDelete: Cascade)
  createdAt            DateTime        @default(now())
  // ─── Soft delete (Trash / recycle bin) ────────────────────────────
  // When a user bulk-trashes transactions, the rows stay in the table
  // with deletedAt set + deleteBatchId pointing at the TrashBatch that
  // groups the action. Every Transaction query MUST filter
  // `deletedAt: null` to hide trashed rows from reports / UI.
  // TrashBatches auto-purge 30 days after their createdAt — see
  // src/lib/trash.ts.
  deletedAt            DateTime?
  deleteBatchId        String?
  deleteBatch          TrashBatch?     @relation(fields: [deleteBatchId], references: [id], onDelete: SetNull)

  @@index([businessId, accountingMonth])
  @@index([businessId, type])
  @@index([businessId, vendor])
  @@index([businessId, deletedAt])
}

// ─── Trash batch ───────────────────────────────────────────────────
// One row per bulk-trash action. Holds a count + creation metadata so
// the recycle-bin UI can render an undo log without re-querying every
// transaction. A TrashBatch is alive until createdAt + 30 days, after
// which the next read triggers permanent deletion of every transaction
// pointing at it AND the batch itself.
model TrashBatch {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deletedById  String?       // user who triggered the trash action
  reason       String?       // optional free-text label ("Categorized as PERSONAL", etc.)
  createdAt    DateTime      @default(now())

  transactions Transaction[]

  @@index([businessId, createdAt])
}

model CategorizationRule {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // matchField: description | vendor | source
  matchField   String
  // matchType: contains | equals | startsWith | regex
  matchType    String
  pattern      String
  categoryId   String
  // optional flags
  setRecurring Boolean  @default(false)
  setOneTime   Boolean  @default(false)
  priority     Int      @default(0)
  createdAt    DateTime @default(now())
}

// VendorizationRule — owner-defined pattern that rewrites
// Transaction.vendor on upload. Mirror of CategorizationRule but the
// target is a vendor name string instead of a category id. Runs
// BEFORE categorization so the new vendor name can flow into vendor-
// based category lookup. Examples:
//   matchField=description, matchType=contains, pattern="VISA*ADS",
//     vendorName="Google Ads"
//   matchField=vendor, matchType=startsWith, pattern="Interest",
//     vendorName="Bank Leumi"
model VendorizationRule {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // matchField: description | vendor | source
  matchField  String
  // matchType: contains | equals | startsWith | regex
  matchType   String
  pattern     String
  vendorName  String   // canonical vendor name to write
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([businessId, priority])
}

model DuplicateGroup {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reason       String // e.g. "amount+date+|<=2 days| & sources differ"
  status       String        @default("open") // open | merged | dismissed
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Employee {
  id                     String          @id @default(cuid())
  businessId             String
  business               Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                   String
  role                   String?
  // Cost breakdown — new fields. When any of these are set, total monthly
  // cost = gross + sum(breakdown). When all are null, we fall back to the
  // legacy gross * employerCostMultiplier calculation so older records
  // continue to work.
  employmentType         String?         @default("employee") // employee | contractor | freelancer
  department             String?
  employerTaxes          Float? // monthly $
  pension                Float?
  benefits               Float?
  additionalCosts        Float?
  // status: active | planned | terminated. Inferred from start/end dates if
  // not set explicitly (legacy rows).
  status                 String?         @default("active")
  grossMonthlySalary     Float
  employerCostMultiplier Float           @default(1.25)
  startDate              DateTime
  endDate                DateTime?
  notes                  String?
  createdAt              DateTime        @default(now())
  events                 EmployeeEvent[]
}

model EmployeeEvent {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  // type: hire | termination | salary_change | bonus | one_time
  type          String
  effectiveDate DateTime
  amount        Float? // for bonus / one_time / salary_change new salary
  notes         String?
  createdAt     DateTime  @default(now())
}

model ForecastItem {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label       String
  // kind: income | expense
  kind        String
  amount      Float
  monthsAhead Int // 1, 2, 3
  notes       String?
  createdAt   DateTime @default(now())
}

// Scenario assumption on top of the baseline forecast. Each row is a single
// business event the user is modeling (a hire, a new contract, a marketing
// cut, etc.). The forecast engine reads these and produces a "scenario" line
// alongside the baseline.
model ForecastAssumption {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // family: revenue | expense | payroll
  family      String
  // type — discriminates which fields are meaningful. e.g. hire, terminate,
  // salary_increase, bonus, contractor_add, contractor_remove,
  // revenue_growth, revenue_decline, new_recurring_revenue,
  // one_time_revenue, lose_recurring_revenue, expense_growth,
  // expense_decline, marketing_change, software_change, rent_increase,
  // one_time_expense, remove_recurring, custom.
  type        String
  label       String
  category    String?
  // amount in $ — interpretation depends on type (monthly cost, one-time
  // hit, etc.). 0 means "not used".
  amount      Float    @default(0)
  // percentage — 0..1 (so 0.05 = 5%). 0 means "not used".
  percentage  Float    @default(0)
  // forecast-relative month index (1 = first projected month).
  startMonth  Int      @default(1)
  // null = open-ended (runs until end of forecast horizon).
  endMonth    Int?
  isRecurring Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
}

model Recommendation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // level: info | good | warn | bad
  level      String   @default("info")
  title      String
  detail     String
  // monthly $ impact, positive = savings or new revenue
  impact     Float    @default(0)
  // bucket: marketing | payroll | vendor | growth | accuracy | cashflow | other
  category   String   @default("other")
  // Stable identifier across regenerations — used to mute a signal kind
  // ("don't show me this again for a week"). E.g. "marketing_intensity_high"
  // or "vendor_spike:Acme". Older rows may be null until regenerated.
  signalKey  String?
  // optional JSON payload — list of action items, employees, vendors, etc.
  payload    String?
  // status: active | dismissed | applied
  status     String   @default("active")
  createdAt  DateTime @default(now())

  @@index([businessId, status, createdAt])
}

// Suppression list for Business Signals. When the user picks "Don't show
// again" on a signal, we save its signalKey here with a mutedUntil 7 days
// out. The generator filters anything whose key is currently muted; once
// mutedUntil passes, the signal becomes eligible again.
model MutedSignal {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  signalKey  String
  mutedUntil DateTime
  createdAt  DateTime @default(now())

  @@unique([businessId, signalKey])
  @@index([businessId, mutedUntil])
}

model Consultation {
  id         String                @id @default(cuid())
  businessId String
  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  messages   ConsultationMessage[]

  @@index([businessId, updatedAt])
}

// ManualEntry: a user-defined recurring (or one-time) income/outcome rule.
// On create, the system materializes Transactions for each occurrence from
// startDate up to (and including) the current month. Future months are
// projected by the forecast engine via the trailing-month average and any
// dedicated forecast logic. Deleting a ManualEntry cascade-deletes all
// Transactions it created.
model ManualEntry {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // type: income | outcome
  type         String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Always stored as a positive number; sign applied at materialization based on type
  amount       Float
  // ISO 4217 currency the user entered the amount in. Defaults to the
  // business base currency. Each materialized Transaction snapshots
  // its own per-occurrence exchange rate; this field is the source of
  // truth for "what did the user actually type".
  currency     String?
  // frequency: one_time | monthly | quarterly | yearly
  frequency    String
  startDate    DateTime
  endDate      DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([businessId, createdAt])
}

model ConsultationMessage {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  // role: user | assistant
  role           String
  content        String
  // optional structured JSON payload (options, items, etc.)
  payload        String?
  // Phase-1 structured advisor output. When present, the UI renders
  // a multi-card layout (executive decision, confidence, drivers,
  // risks, recommendation) instead of the markdown content. Older
  // assistant messages + mock-mode fallbacks leave this null.
  structured     Json?
  createdAt      DateTime     @default(now())

  @@index([consultationId, createdAt])
}

// Local cache of exchange rates. Looked up before every external
// Frankfurter call so a CSV import that touches the same currency/
// date pair across many rows hits the API once. Also serves as the
// audit record for which rate was in effect on a given day.
model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String // ISO 4217 — currency the rate converts INTO
  quoteCurrency String // ISO 4217 — currency the rate converts FROM
  rate          Float // 1 unit of quoteCurrency = `rate` units of baseCurrency
  rateDate      DateTime // date the rate applies to (UTC midnight)
  // Date the rate provider actually returned. May differ from rateDate
  // when we requested a non-trading day and got the previous trading
  // day back ("rolled" rate).
  effectiveDate DateTime
  source        String // "frankfurter" | "ecb" | "manual"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency, rateDate, source])
  @@index([baseCurrency, quoteCurrency, rateDate])
}

// ─────────────────────────────────────────────────────────────────────
// Billing: Subscription, AdminPlanOverride, AI Credits, Coupons
// ─────────────────────────────────────────────────────────────────────
// Provider-agnostic schema - `externalCustomerId` / `externalSubscriptionId`
// / `externalPriceId` are populated by whichever billing provider gets
// wired in (Stripe, Paddle, Lemon Squeezy, etc). Until that lands, the
// admin override path is enough to assign paid access manually.
//
// Plan values are kept as strings rather than a Prisma enum to match the
// existing schema convention (no enums anywhere else in the file). Valid
// values: "free" | "pro" | "business".
//
// The pre-existing Business.plan String field is kept as a legacy display
// hint - the new source of truth is getEffectivePlan() in src/lib/billing
// which composes AdminPlanOverride > Subscription > "free" default.

model Subscription {
  id                     String    @id @default(cuid())
  businessId             String
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                   String // "free" | "pro" | "business"
  // "active" | "trialing" | "past_due" | "canceled" | "incomplete"
  status                 String    @default("active")
  currentPeriodStart     DateTime  @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean   @default(false)
  // Set when the subscription is cancelled mid-period or at period end.
  // null until cancel is requested.
  cancelledAt            DateTime?
  // Billing-provider identifiers. Populated only when a provider is wired
  // up; kept generic so we're not locked to one provider.
  externalProvider       String? // "stripe" | "paddle" | "lemon" | null
  externalCustomerId     String?
  externalSubscriptionId String?
  externalPriceId        String?
  // Optional coupon snapshot applied at the start of this subscription
  // - kept here so a redemption history persists even if the coupon row
  // is later disabled or deleted.
  appliedCouponCode      String?
  // Grandfather flag for "Share Insights" (originally "shareAnalyses").
  // The entitlement moved from Pro to Business when the Business tier
  // launched; rather than yank the feature from existing paying Pro
  // customers we stamp true on every Pro subscription that existed at
  // flip-day. New Pro subs default to false. Checked inside
  // hasFeature("shareAnalyses") - see src/lib/billing/entitlements.ts.
  shareInsightsGrandfathered Boolean @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([businessId, status])
  @@index([externalSubscriptionId])
}

// Super-admin can manually assign paid access to any business without
// going through the billing system. Override wins over Subscription
// while active. Audited via AuditLog.
model AdminPlanOverride {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // The admin user who applied the override.
  assignedById   String
  assignedBy     User      @relation("AdminPlanOverrideAssignedBy", fields: [assignedById], references: [id])
  // Plan to apply for the duration of the override.
  plan           String // "free" | "pro" | "business"
  // Type: "full_paid" | "trial_extension" | "unlimited_credits" | "custom"
  kind           String    @default("full_paid")
  effectiveFrom  DateTime  @default(now())
  // Null = indefinite.
  effectiveUntil DateTime?
  // Optional one-time credit grant attached to the override (used for
  // "trial extension with 200 bonus credits" style grants).
  creditsGranted Int?
  // Free-form internal note from the admin (why was this granted?).
  note           String?
  // Set when override is manually revoked before effectiveUntil.
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?     @relation("AdminPlanOverrideRevokedBy", fields: [revokedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessId, effectiveFrom, effectiveUntil])
}

// Denormalised running balance per business. Updated on every grant /
// consume via the billing library; transactions are the audit ledger.
model AiCreditWallet {
  id               String   @id @default(cuid())
  businessId       String   @unique
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Current available credits (sum of all unexpired transactions).
  balance          Int      @default(0)
  // The plan's monthly allowance at the start of the current period.
  // Used so we can detect plan changes mid-period and pro-rate grants.
  monthlyAllowance Int      @default(0)
  // Start of the current monthly window (used for monthly reset logic).
  periodStart      DateTime @default(now())
  // Lifetime counters for reporting / analytics. Never reset.
  lifetimeGranted  Int      @default(0)
  lifetimeConsumed Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@index([periodStart])
}

// Ledger of every credit movement. Source of truth; the wallet is a
// cache.
model AiCreditTransaction {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Positive = grant, negative = spend.
  delta        Int
  // "monthly_grant" | "consume" | "purchase" | "admin_grant"
  // | "coupon" | "expiry" | "adjustment"
  kind         String
  // Free-form context, eg "AI consultation #abc" or "Pro monthly allowance".
  reason       String?
  // Snapshot of wallet.balance immediately after this transaction was
  // applied. Lets you reconstruct a balance timeline without summing the
  // whole ledger.
  balanceAfter Int
  // For purchase grants. Credits expire on this date; the monthly job
  // creates a negative "expiry" transaction when the deadline passes.
  expiresAt    DateTime?
  // Reference data (consultation id, coupon id, override id, etc.).
  meta         Json?
  createdAt    DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, kind])
  @@index([expiresAt])
}

// Coupon definition. Codes are matched case-insensitively in the
// billing library; admins can store them in any case.
model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  // "percentage" | "fixed_amount" | "credits" | "trial_extension"
  kind             String
  // Interpretation depends on kind:
  //   percentage         -> 0-100 (percent off)
  //   fixed_amount       -> cents off (USD)
  //   credits            -> credit count to grant on redemption
  //   trial_extension    -> days of trial to add
  value            Int
  // Usage caps. Null = unlimited.
  maxRedemptions   Int?
  maxPerUser       Int?
  usedCount        Int       @default(0)
  // Validity window.
  startsAt         DateTime?
  expiresAt        DateTime?
  // Plan restrictions. Empty arrays = no restriction.
  applicablePlans  String[]  @default([])
  excludedPlans    String[]  @default([])
  // Billing-cycle behaviour for percentage / fixed_amount coupons.
  // "first_payment" | "recurring_forever" | "limited_cycles" | null.
  billingCycle     String?
  // For "limited_cycles" only - number of cycles the discount applies.
  cycleCount       Int?
  // Targeting. Set any of these to restrict redemption.
  targetEmail      String?
  targetUserId     String?
  targetUser       User?     @relation("CouponTargetUser", fields: [targetUserId], references: [id])
  targetBusinessId String?
  targetBusiness   Business? @relation("CouponTargetBusiness", fields: [targetBusinessId], references: [id])
  // Admin metadata.
  internalNote     String?
  createdById      String
  createdBy        User      @relation("CouponCreatedBy", fields: [createdById], references: [id])
  // Soft-disable flag.
  disabled         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
  @@index([disabled, expiresAt])
}

model CouponRedemption {
  id               String   @id @default(cuid())
  couponId         String
  coupon           Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Snapshot of the redemption effect (so the audit trail survives the
  // coupon being modified later).
  discountAmount   Int? // cents - only set for percentage/fixed_amount
  creditsGranted   Int? // only set for credits coupons
  trialDaysGranted Int? // only set for trial_extension coupons
  // Optional reference to the subscription this redemption applied to.
  subscriptionId   String?
  redeemedAt       DateTime @default(now())

  @@unique([couponId, userId, businessId])
  @@index([userId])
  @@index([businessId])
}

// Polar order ledger. Synced from the Polar webhook so the customer
// Billing & Products page + the super-admin orders dashboard can show
// every paid event (initial subscription, renewals, credit packs,
// refunds) without calling Polar's API on every page load.
//
// Source of truth for amounts/status: the Polar webhook payload at
// the time it fires. The invoice PDF URL is fetched on-demand via the
// /api/billing/orders/[id]/invoice endpoint (Polar emits short-lived
// signed URLs) so we don't cache stale links.
model PolarOrder {
  id                  String    @id @default(cuid())

  // ── Polar identifiers ─────────────────────────────────────────────
  polarOrderId        String    @unique
  // Polar's human-facing invoice number ("INV-12345"). Distinct from
  // polarOrderId which is the opaque UUID.
  polarOrderNumber    String?
  polarCustomerId     String?
  polarCustomerEmail  String?
  polarProductId      String?
  // Null for one-time orders (credit packs). Set on subscription
  // orders (initial + renewals).
  polarSubscriptionId String?
  polarCheckoutId     String?

  // ── App context (snapshot at write time) ──────────────────────────
  // Snapshot fields stay readable even if the underlying user/
  // business is later renamed or deleted.
  userId              String?
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessId          String?
  business            Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessName        String?

  // ── Product context ───────────────────────────────────────────────
  productName  String?
  // "subscription" | "credits" | "addon" | "one_time"
  productType  String
  // "new_subscription" | "renewal" | "upgrade" | "downgrade"
  // | "credits_purchase" | "one_time_purchase"
  purchaseType String
  planId       String?
  creditsAmount Int?

  // ── Money ─────────────────────────────────────────────────────────
  // Total amount in cents (Polar's totalAmount). Currency is whatever
  // Polar charged in (usually USD for this platform).
  amountCents Int
  currency    String @default("USD")

  // ── Status ────────────────────────────────────────────────────────
  // Mirrors Polar OrderStatus:
  //   "paid" | "pending" | "refunded" | "partially_refunded" | "void"
  status String

  // ── Invoice ───────────────────────────────────────────────────────
  invoiceNumber    String?
  invoiceGenerated Boolean @default(false)
  // Last-seen Polar invoice PDF URL. Polar emits short-lived signed
  // URLs so we refresh on-demand via the invoice endpoint rather than
  // rely on this column - it's mostly informational/forensic.
  invoicePdfUrl    String?
  // Raw Polar billingReason: "purchase" | "subscription_create"
  // | "subscription_cycle" | "subscription_update".
  billingReason    String?

  // ── Forensics ─────────────────────────────────────────────────────
  // Full checkout metadata as it landed on the webhook payload, kept
  // for incident triage when something is mis-mapped to a workspace.
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([polarCustomerEmail])
  @@index([status])
  @@index([createdAt])
}

// Persisted business signal. Replaces the prior "recompute every page
// load, never store" model. Each row represents one instance of a
// detected signal in the business context; the lifecycle progresses
// active -> acknowledged (user has seen it but the condition still
// holds) -> resolved (underlying condition disappeared OR user marked
// it resolved). A resolved signal stays in history for audit; if the
// same signalKey comes back later, a brand-new row is opened so the
// timeline is honest.
model BusinessSignal {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Stable identifier from the deterministic evaluator. Used to
  // match candidate signals against existing rows on re-evaluation.
  // Examples: "vendor_spike:Acme", "marketing_intensity_high".
  signalKey       String

  // Detected level + ranked monthly $ impact. Both are mutable - if
  // a re-evaluation produces the same signalKey at a worse level or
  // a different impact, we update the row AND emit a notification.
  level           String   // "bad" | "warn" | "good" | "info"
  impact          Float    // estimated monthly $ impact (0 for observational)

  // Rendered content shown on the signal card + the detail view.
  observation     String
  interpretation  String
  recommendation  String
  category        String   // "marketing" | "payroll" | "vendor" | "growth" | "accuracy" | "cashflow" | "other"

  // Lifecycle.
  //   "active"       - currently true in the data, not yet acted on
  //   "acknowledged" - user marked it read; condition still holds
  //   "resolved"     - condition no longer holds (system or user marked)
  //   "archived"     - aged out / superseded
  status          String   @default("active")
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  resolvedBy      String?  // "system" when auto-resolved, "user" when manual

  // Tracking - useful for ranking + the explanation panel.
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  evaluationCount Int      @default(1) // how many evaluations saw this signal

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Lookup patterns: list active signals for a workspace, match a
  // candidate against existing open rows by signalKey, page through
  // the resolved-history feed.
  @@index([businessId, status])
  @@index([businessId, signalKey, status])
  @@index([businessId, status, impact(sort: Desc)])
}

// Secure read-only share of a single AI-generated analysis (consultation
// answer, business signal, forecast explanation, or insight). Recipients
// open `/share/<token>` without a Tweaxly account and see a snapshot of
// the analysis as it existed at share-time — never re-running the AI,
// never pulling fresh workspace data.
//
// Entitlement gate: SharedAnalysis is only writable when the workspace's
// effective plan has PlanFeatures.shareAnalyses === true (Pro at launch).
// Reads on /share/<token> never check the workspace plan — once a link
// is generated and active, expiry and password are the only gates.
model SharedAnalysis {
  id                String   @id @default(cuid())
  // Workspace scoping. Cascade delete: when a workspace is deleted
  // its share links are revoked along with it.
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Author of the share link. NOT cascade-delete — if the creator's
  // user record is wiped we still want the workspace owner to be
  // able to revoke active shares, so keep the row and let the FK
  // hold a stale id (the management UI shows "deleted user").
  createdByUserId   String
  createdByUser     User     @relation("SharedAnalysisCreator", fields: [createdByUserId], references: [id], onDelete: NoAction)

  // What was shared. `sourceType` is one of: "consultation",
  // "signal", "forecast_explanation", "insight". `sourceId` points
  // at the originating row (e.g. ConsultationMessage.id for a
  // consultation answer) for back-tracing but is not relied on at
  // read time — the snapshot below is authoritative.
  sourceType        String
  sourceId          String

  // The snapshot. `snapshotContent` is the JSON-serialised payload
  // the public viewer renders through ResponseBriefing /
  // StructuredAdvisoryView — same shape as ConsultationMessage's
  // {content, payload, structured} so the public page reuses the
  // exact components used in the New Advisory view.
  // `snapshotMeta` carries lightweight display context like the
  // user's question, asked-at timestamp, workspace currency, and
  // the analysis title.
  snapshotContent   Json
  snapshotMeta      Json

  // Lookup token. The user-facing URL is /share/<token>. Generated
  // via crypto.randomBytes(32).toString("base64url") so it is
  // unguessable; unique-indexed for O(1) lookup. The token IS the
  // secret — anyone who has it can view the share (subject to
  // expiry + password).
  token             String   @unique

  // Optional password gate. Hashed with bcrypt (same library +
  // cost factor used elsewhere in the codebase). Null means no
  // password required. Plaintext is never stored.
  passwordHash      String?

  // Hard cutoff. After this moment the public viewer returns the
  // "expired" state regardless of `isActive`.
  expiresAt         DateTime

  // Manual revoke. Defaults to true; setting false from the
  // management UI immediately disables the link without losing
  // the row (so we keep analytics + can re-enable later).
  isActive          Boolean  @default(true)

  // View analytics — updated on every successful render of the
  // public page (after auth-by-token + password check pass).
  viewCount         Int      @default(0)
  firstViewedAt     DateTime?
  lastViewedAt      DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Lookup patterns: workspace management list (newest first),
  // creator-scoped list for the per-user "my shares" view.
  @@index([businessId, createdAt(sort: Desc)])
  @@index([createdByUserId, createdAt(sort: Desc)])
}
